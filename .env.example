# Server-only Vercel variables. Never prefix these with VITE_ and never commit real keys.
RESEND_API_KEY=re_your_resend_api_key
CONTACT_TO_EMAIL=support@morapp.tech
MERCHANT_TO_EMAIL=support@morapp.tech
CONTACT_FROM_EMAIL=MOR Website <website@morapp.tech>

# Public browser configuration used by MOR Admin. The anon key is safe to expose;
# authorization remains enforced by Supabase Auth, public.is_admin(), and RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
